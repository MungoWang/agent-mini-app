{
  "name": "monkey-mini-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage packages/host/tests packages/panel/tests packages/dsh/tests",
    "lint": "eslint packages/host packages/panel packages/dsh",
    "lint:fix": "eslint packages/host packages/panel packages/dsh --fix",
    "smoke": "vitest run packages/smoke-test",
    "typecheck": "tsc -b --pretty false",
    "skill:gen": "node scripts/generate-skill.mjs",
    "react-host": "tsx scripts/dev-react-host.mts",
    "tpl:check": "tsx scripts/check-templates.mts",
    "build:ui": "node scripts/build-ui.mjs",
    "publish:prep": "pnpm build:ui && pnpm skill:gen && pnpm --filter @monkey-mini-app/dsh-mini-app build",
    "publish": "pnpm publish:prep && pnpm -r publish",
    "dsh:debug": "tsx scripts/dsh-debug-switch.mts debug",
    "dsh:prod": "tsx scripts/dsh-debug-switch.mts prod",
    "publish:packages": "tsx scripts/publish.mts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
