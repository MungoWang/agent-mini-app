{
  "name": "monkey-mini-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage packages/host/tests packages/panel/tests packages/dsh/tests",
    "lint": "eslint packages/host packages/panel packages/dsh",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -b --pretty false",
    "skill:gen": "node scripts/generate-skill.mjs",
    "build:ui": "node scripts/build-ui.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.39.5",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
