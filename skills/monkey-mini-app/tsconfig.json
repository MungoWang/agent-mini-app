{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@monkey-mini-app/api": ["../../packages/api/src/index.ts"],
      "@monkey-mini-app/ui": ["../../packages/ui/src/index.ts"],
      "@monkey-mini-app/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["templates/**/*.ts", "templates/**/*.tsx", "types/**/*.d.ts"]
}
