{
  "name": "@monkey-mini-app/dsh-monkey-mini-app",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle: monkey-mini-app runtime tools, skills, and multi-tab host wiring",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "import": "./lib/client.js",
      "require": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "tsup.config.ts",
    "skills"
  ],
  "scripts": {
    "build": "rm -rf lib && tsup",
    "prepare": "rm -rf lib && tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "monkey-mini-app"
  ],
  "dependencies": {
    "isomorphic-git": "^1.27.1",
    "pinyin-pro": "^3.29.3",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
