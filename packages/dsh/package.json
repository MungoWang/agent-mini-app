{
  "name": "@monkey-mini-app/dsh-mini-app",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: mini-app host wiring, panel, and skills",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.cts",
      "import": "./lib/client.js",
      "require": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "tsup.config.ts",
    "skills",
    "assets"
  ],
  "scripts": {
    "build": "rm -rf lib && tsup",
    "prepare": "rm -rf lib && tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm --filter @monkey-mini-app/ui build && node ../../scripts/generate-skill.mjs && rm -rf lib && tsup"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "monkey-mini-app"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@hono/node-server": "^2.1.1",
    "@monkey-mini-app/host": "^0.1.0",
    "@monkey-mini-app/panel": "^0.1.0",
    "@monkey-mini-app/ui": "^0.1.0",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.25.12",
    "hono": "^4.8.0",
    "i18next": "^25.4.0",
    "isomorphic-git": "^1.29.0",
    "sucrase": "^3.35.1"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "19",
    "@types/react-dom": "19",
    "lucide-react": "^0.544.0",
    "react": "19",
    "react-dom": "19",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
