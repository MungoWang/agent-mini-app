{
  "name": "@monkey-mini-app/shell",
  "version": "0.1.0",
  "description": "Shell Host owner for split deploy: createHost + connect(AgentCapabilities)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
