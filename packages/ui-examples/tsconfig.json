{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "paths": {
      "@monkey-mini-app/ui": ["../ui/src/index.ts"],
      "@monkey-mini-app/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src"]
}
