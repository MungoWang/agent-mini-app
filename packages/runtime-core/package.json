{
  "name": "@monkey-mini-app/runtime-core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@monkey-mini-app/bridge-protocol": "workspace:*",
    "@monkey-mini-app/host-port": "workspace:*",
    "@monkey-mini-app/api-client": "workspace:*",
    "@monkey-mini-app/theme-light": "workspace:*",
    "@monkey-mini-app/theme-dark": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "tsup": "^8.3.6",
    "@types/node": "^22.13.4",
    "@monkey-mini-app/adapter-node": "workspace:*",
    "@monkey-mini-app/app-history-git": "workspace:*",
    "@monkey-mini-app/app-history": "workspace:*"
  }
}
