  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "node ../../scripts/build/api.mjs",
    "prepack": "node ../../scripts/build/api.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
