{
  "name": "@monkey-mini-app/api",
  "version": "0.1.0",
  "description": "Mini-app backend author contract: defineApp + AppCtx types (host injects runtime)",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
