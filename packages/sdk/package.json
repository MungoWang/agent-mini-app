{
  "name": "@monkey-mini-app/sdk",
  "version": "0.1.0",
  "description": "Mini-app authoring SDK: React hooks, UI kit, and useApp()",
  "type": "module",
  "private": false,
  "main": "./dist/sdk.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build/sdk.mjs",
    "prepack": "node ../../scripts/build/sdk.mjs"
  },
  "dependencies": {
    "@monkey-mini-app/ui": "^0.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
