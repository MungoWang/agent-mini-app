{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@monkey-mini-app/panel": ["../../packages/panel/src/index.ts"],
      "@monkey-mini-app/ui": ["../../packages/ui/src/index.ts"],
      "@monkey-mini-app/ui/globals.css": ["../../packages/ui/src/styles/globals.css"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
