{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["playwright.config.ts", "e2e", "scripts"],
  "exclude": ["node_modules", ".dsh", "registry", "mma-runtime", "test-results"]
}
